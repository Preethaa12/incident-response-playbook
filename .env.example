# ==============================================================================
# SentinelX AI — Intelligent Incident Response Command Center
# Environment Configuration & Integration Template
# ==============================================================================

# Application Mode:
# When credentials below are omitted, SentinelX runs in full local demonstration mode
# using an interactive local storage engine with deterministic safety guardrails.
VITE_APP_MODE=demo

# Optional: Server-Side AI Copilot Endpoint
# If configured, requests to the AI Copilot will be routed to your authenticated backend
# server which forwards prompts securely to your LLM provider.
# NEVER expose OpenAI/Gemini/Anthropic API keys directly in client-side VITE_ variables!
# Example: https://api.northstarlabs.edu.test/api/v1/ir-copilot
VITE_AI_API_URL=

# Optional: Supabase Persistent Database (Optional Backend Sync)
# Leave blank to persist records in browser LocalStorage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: External Automation Webhook Endpoint (e.g. Zapier / Make Gateway)
# All external webhooks must be routed through an authenticated backend proxy.
# NEVER expose raw webhook secrets in client source code!
VITE_WEBHOOK_PROXY_URL=
